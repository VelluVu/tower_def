[sub_resource type="Resource" id="PuffeLine_1"]
script = ExtResource("9_line")
trigger = 0
text = "The big cave by the river. Something huge stirs in there, and this castle has no walls yet. Build fast!"

[sub_resource type="Resource" id="PuffeLine_2"]
script = ExtResource("9_line")
trigger = 3
wave_number = 2
text = "The deep caves send everything they have. Keep the roads long."

[sub_resource type="Resource" id="PuffeLine_3"]
script = ExtResource("9_line")
trigger = 7
text = "Do not let them through, the eggs are right behind us!"

[sub_resource type="Resource" id="PuffeLine_4"]
script = ExtResource("9_line")
trigger = 3
wave_number = 6
text = "There she is: the Broodmother. Mother of all the cave folk, and she does not like miners."

[sub_resource type="Resource" id="PuffeLine_5"]
script = ExtResource("9_line")
text = "Focus her down, and pop her brood before it scatters. I know a thing or two about guarding eggs."

[resource]
script = ExtResource("1_level")
level_name = "Broodmother's Lair"
story_text = "The castle by the great cave needs help now. The miners dug too deep, and something big is coming up from below."
starting_gold = 20.0
waves = Array[ExtResource("0_wave")]([ExtResource("w1"), ExtResource("w2"), ExtResource("w3"), ExtResource("w4"), ExtResource("w5"), ExtResource("w6")])
puffe_lines = Array[ExtResource("9_line")]([SubResource("PuffeLine_1"), SubResource("PuffeLine_2"), SubResource("PuffeLine_3"), SubResource("PuffeLine_4"), SubResource("PuffeLine_5")])
