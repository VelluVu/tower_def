[sub_resource type="Resource" id="PuffeLine_1"]
script = ExtResource("9_line")
trigger = 0
text = "The southern bridge is gone, smashed into the river. No wading for us: the lake road west it is, past tunnels on every side."
mood = 2

[sub_resource type="Resource" id="PuffeLine_2"]
script = ExtResource("9_line")
trigger = 3
wave_number = 2
text = "Batlings, with a swarm behind them! They fly over the maze. The violet dots show their route: Bolters and Beamers along it, a Nova for the swarm (it reaches flyers from its T2)."

[sub_resource type="Resource" id="PuffeLine_3"]
script = ExtResource("9_line")
trigger = 3
wave_number = 5
text = "A new tunnel in the north-east! They are digging their way closer."

[sub_resource type="Resource" id="PuffeLine_4"]
script = ExtResource("9_line")
trigger = 7
text = "They found a gap. Close it!"
mood = 2

[sub_resource type="Resource" id="PuffeLine_5"]
script = ExtResource("9_line")
trigger = 3
wave_number = 6
text = "Hold the crossing, and we can face whatever is down there."

[resource]
script = ExtResource("1_level")
level_name = "Echo Crossing"
story_text = "The southern bridge lies smashed in the river, and the drakelings will not carry their loads through water. The way on turns back west along the lake, and the tunnels round this old crossing echo with something big moving below."
starting_gold = 27.0
waves = Array[ExtResource("0_wave")]([ExtResource("w1"), ExtResource("w2"), ExtResource("w3"), ExtResource("w4"), ExtResource("w5"), ExtResource("w6")])
