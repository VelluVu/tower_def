[sub_resource type="Resource" id="PuffeLine_1"]
script = ExtResource("9_line")
trigger = 0
text = "Hear that squeaking? A batling roost. Something deep below has woken them."

[sub_resource type="Resource" id="PuffeLine_2"]
script = ExtResource("9_line")
trigger = 3
wave_number = 2
text = "Batlings! They fly over the maze. The violet dots show their route, so put towers along it."

[sub_resource type="Resource" id="PuffeLine_3"]
script = ExtResource("9_line")
trigger = 7
text = "Over the walls they come. Cover the flight route!"

[sub_resource type="Resource" id="PuffeLine_4"]
script = ExtResource("9_line")
trigger = 3
wave_number = 4
text = "Beeflings on the ground, batlings in the air. Watch both."

[sub_resource type="Resource" id="PuffeLine_5"]
script = ExtResource("9_line")
trigger = 3
wave_number = 5
text = "Last wave. Hold the gate!"

