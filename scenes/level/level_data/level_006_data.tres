[sub_resource type="Resource" id="PuffeLine_1"]
script = ExtResource("9_line")
trigger = 0
text = "Smell that? The swamp. Damp, smelly and far too noisy for a nap."

[sub_resource type="Resource" id="PuffeLine_2"]
script = ExtResource("9_line")
trigger = 3
wave_number = 3
text = "Big, wet and grumpy. Just like me before breakfast."

[sub_resource type="Resource" id="PuffeLine_3"]
script = ExtResource("9_line")
trigger = 3
wave_number = 5
text = "The last wave of the forest. Then... the swamp. Sigh."

[resource]
