[sub_resource type="Resource" id="PuffeLine_1"]
script = ExtResource("9_line")
text = "Stepping stones over the channels. Only the toads and leeches dare them."

[sub_resource type="Resource" id="PuffeLine_mortar"]
script = ExtResource("9_line")
text = "A new drakeling joins us: the Mortar! Its shells burst on a whole crowd of leeches, but it can't hit what's at its feet, or anything flying."
