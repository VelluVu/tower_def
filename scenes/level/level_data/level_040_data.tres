[sub_resource type="Resource" id="PuffeLine_1"]
script = ExtResource("9_line")
text = "Dragon bones. Hundreds of them. We do not talk about this place."

[sub_resource type="Resource" id="PuffeLine_2"]
script = ExtResource("9_line")
trigger = 3
wave_number = 2
text = "Ash drakes. They were dragons once. Rest now, cousins. Towers along their flight!"
mood = 3

[sub_resource type="Resource" id="PuffeLine_u1125_bone_vulture"]
script = ExtResource("9_line")
trigger = 3
wave_number = 3
text = "Bone vultures! Shoot one down and its bones keep walking. Frost keeps them down for good."

[sub_resource type="Resource" id="PuffeLine_3"]
script = ExtResource("9_line")
trigger = 4
wave_number = 6
text = "Whoever raised them knows dragons well. Too well."

