[sub_resource type="Resource" id="PuffeLine_1"]
script = ExtResource("9_line")
text = "Walls of bone, built by the dead. Each one has a gap. Each gap is a door for them, and a trap for us."

[sub_resource type="Resource" id="PuffeLine_2"]
script = ExtResource("9_line")
trigger = 3
wave_number = 3
text = "Three roads, one gate at a time. Build where they all have to pass."

[sub_resource type="Resource" id="PuffeLine_3"]
script = ExtResource("9_line")
trigger = 4
wave_number = 6
text = "Past the last wall. The elder is close now. I wish it were not."

[resource]
script = ExtResource("1_level")
level_name = "Gate of Bones"
story_text = "Four walls of bone across the road to the elder's resting place, a gap in each. Everything the desert has comes through them at once."
