[sub_resource type="Resource" id="PuffeLine_1"]
script = ExtResource("9_line")
trigger = 0
text = "The old tunnels are caving in, and the cave folk are pouring out of them. Right through here."

[sub_resource type="Resource" id="PuffeLine_2"]
script = ExtResource("9_line")
trigger = 3
wave_number = 2
text = "Batlings from the old roost. Mind the flight route."

[sub_resource type="Resource" id="PuffeLine_3"]
script = ExtResource("9_line")
trigger = 3
wave_number = 4
text = "The ground caved in, a tunnel in the middle of the field!"
mood = 3

[sub_resource type="Resource" id="PuffeLine_4"]
script = ExtResource("9_line")
trigger = 7
text = "They are not even fighting, just running from something. But not into our castle!"
mood = 2

[sub_resource type="Resource" id="PuffeLine_5"]
script = ExtResource("9_line")
trigger = 3
wave_number = 6
text = "The last of them. Whatever woke down there is heading north, and so are we."

[sub_resource type="Resource" id="PuffeLine_u1125_cave_shaman"]
script = ExtResource("9_line")
trigger = 3
wave_number = 5
text = "That old shaman wraps its friends in stone. The first hit just bounces off: hit them twice!"
mood = 3

