[sub_resource type="Resource" id="PuffeLine_1"]
script = ExtResource("9_line")
trigger = 0
text = "Hear that squeaking? A batling roost. Something deep below has woken them."
mood = 2

[sub_resource type="Resource" id="PuffeLine_egg_bomb"]
script = ExtResource("9_line")
trigger = 1
text = "Meet the Egg Bomb! Not every egg is meant to hatch. Set it on the road, let the first one step on it, and stand well back."
mood = 4

[sub_resource type="Resource" id="PuffeLine_2"]
script = ExtResource("9_line")
trigger = 3
wave_number = 2
text = "Batlings again, a whole roost of them. Bolters and Beamers along the violet route."

[sub_resource type="Resource" id="PuffeLine_3"]
script = ExtResource("9_line")
trigger = 7
text = "Over the walls they come. Cover the flight route!"
mood = 2

[sub_resource type="Resource" id="PuffeLine_4"]
script = ExtResource("9_line")
trigger = 3
wave_number = 4
text = "Beeflings on the ground, batlings in the air. Watch both."

[sub_resource type="Resource" id="PuffeLine_5"]
script = ExtResource("9_line")
trigger = 3
wave_number = 5
text = "Last wave. Hold the gate!"
mood = 3

[sub_resource type="Resource" id="PuffeLine_u1125_glow_moth"]
script = ExtResource("9_line")
trigger = 3
wave_number = 3
text = "Glow moths, a whole flock on the wind! Bolters and Beamers, look up!"
mood = 2

[sub_resource type="Resource" id="PuffeLine_u1125_tunnel_rat"]
script = ExtResource("9_line")
trigger = 3
wave_number = 5
text = "Rats! They scurry under our traps and eggs. Towers have to catch these ones."
mood = 2

