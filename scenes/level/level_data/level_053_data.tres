[sub_resource type="Resource" id="PuffeLine_1"]
script = ExtResource("9_line")
text = "An island in a ring of fire, and they come from every side. Good thing I am awake."

[sub_resource type="Resource" id="PuffeLine_2"]
script = ExtResource("9_line")
trigger = 3
wave_number = 1
text = "Bones from the west, fire from the east. One element will not hold every bridge."

[sub_resource type="Resource" id="PuffeLine_3"]
script = ExtResource("9_line")
trigger = 3
wave_number = 2
text = "The cracks on the west and east roads glow. Cool them, or route around."

[sub_resource type="Resource" id="PuffeLine_4"]
script = ExtResource("9_line")
trigger = 3
wave_number = 3
text = "Golems and phoenixes up the south road. The Wyrm is sending everything."

[resource]
script = ExtResource("1_level")
level_name = "Caldera Rim"
story_text = "The old crater, a ring of lava around an island castle. Everything the Wyrm commands converges on it: its dead from the desert, its fire creatures from the slopes, its cultists from their monastery."
starting_gold = 35.0
waves = Array[ExtResource("0_wave")]([ExtResource("w1"), ExtResource("w2"), ExtResource("w3"), ExtResource("w4"), ExtResource("w5"), ExtResource("w6"), ExtResource("w7")])
