[sub_resource type="Resource" id="PuffeLine_1"]
script = ExtResource("9_line")
text = "Their war camp. Tents, banners, and a lot of shiny swords. I do not like shiny swords."

[sub_resource type="Resource" id="PuffeLine_2"]
script = ExtResource("9_line")
trigger = 3
wave_number = 2
text = "Their camp cavalry knows these roads. Keep the road long and the towers close."

[sub_resource type="Resource" id="PuffeLine_3"]
script = ExtResource("9_line")
trigger = 3
wave_number = 7
text = "The Dragonslayer. He has hunted dragons before. He has never met Puffe."

[sub_resource type="Resource" id="PuffeLine_4"]
script = ExtResource("9_line")
trigger = 4
wave_number = 7
text = "His last words: my oath was sworn to the one in the mountain. The volcano rumbles. No haystack nap for me yet."
mood = 4

