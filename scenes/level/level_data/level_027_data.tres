wave_number = 2
text = "Cavalry! Fast and tough. Make the road long so the towers get many hits."

[sub_resource type="Resource" id="PuffeLine_3"]
script = ExtResource("9_line")
trigger = 3
wave_number = 3
text = "Armored knights shrug off the small hits. Slow them at the fords."

[sub_resource type="Resource" id="PuffeLine_4"]
