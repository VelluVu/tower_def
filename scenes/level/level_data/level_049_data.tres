text = "Salamanders swim the lava. Watch the ford and the far bank."

[sub_resource type="Resource" id="PuffeLine_4"]
script = ExtResource("9_line")
trigger = 3
wave_number = 3
text = "Fire barely hurts them here. Frost does."

