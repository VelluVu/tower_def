[sub_resource type="Resource" id="PuffeLine_1"]
script = ExtResource("9_line")
text = "Sand. Ash. More sand. I cannot sleep on sand, it gets everywhere."

[sub_resource type="Resource" id="PuffeLine_u1125_elder_drake"]
