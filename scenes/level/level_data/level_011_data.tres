[sub_resource type="Resource" id="PuffeLine_1"]
script = ExtResource("9_line")
trigger = 0
text = "Humans! They have barricaded the bridge, and now they are coming over it. The great cave is right behind us: hold this castle, or they reach the eggs behind our backs."
mood = 3

[sub_resource type="Resource" id="PuffeLine_hatchery"]
script = ExtResource("9_line")
text = "Meet the Hatchery! Its hatchlings are raised on beetle mash and vitamins. Put them on the bridge and they will hold it, one human each."
mood = 1

[sub_resource type="Resource" id="PuffeLine_2"]
script = ExtResource("9_line")
trigger = 3
wave_number = 2
text = "Scouts. Fast and lightly armed, so the Beamer keeps up with them."

[sub_resource type="Resource" id="PuffeLine_3"]
script = ExtResource("9_line")
trigger = 3
wave_number = 3
text = "War dogs, in packs! The Nova is made for this."

[sub_resource type="Resource" id="PuffeLine_4"]
script = ExtResource("9_line")
trigger = 7
text = "Humans at the castle! Not one egg leaves this place."
mood = 2

[sub_resource type="Resource" id="PuffeLine_5"]
script = ExtResource("9_line")
trigger = 3
wave_number = 5
text = "One last push. Hold the bridge, and we can go down into the great cave."
mood = 1

[resource]
script = ExtResource("1_level")
level_name = "Barricade Bridge"
story_text = "The humans have taken the middle bridge and barricaded it, their banner planted on the stakes. The great cave with the hidden eggs lies just behind this bank: hold the castle here first, or they will be at the eggs while the drakelings face what waits below."
starting_gold = 23.0
waves = Array[ExtResource("0_wave")]([ExtResource("w1"), ExtResource("w2"), ExtResource("w3"), ExtResource("w4"), ExtResource("w5")])
puffe_lines = Array[ExtResource("9_line")]([SubResource("PuffeLine_1"), SubResource("PuffeLine_hatchery"), SubResource("PuffeLine_2"), SubResource("PuffeLine_3"), SubResource("PuffeLine_4"), SubResource("PuffeLine_5")])
first_wave_health = 2.2
last_wave_health = 3.6
health_scale = 1.45
hard_health_scale = 1.311
