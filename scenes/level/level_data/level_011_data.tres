[sub_resource type="Resource" id="PuffeLine_1"]
script = ExtResource("9_line")
trigger = 0
text = "Humans! They hold the bridge, our only way north. Fortify this castle and hold them back."

[sub_resource type="Resource" id="PuffeLine_2"]
script = ExtResource("9_line")
trigger = 3
wave_number = 2
text = "Scouts. Fast and lightly armed, so the Beamer keeps up with them."

[sub_resource type="Resource" id="PuffeLine_3"]
