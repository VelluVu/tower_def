[sub_resource type="Resource" id="PuffeLine_1"]
script = ExtResource("9_line")
text = "Haystacks everywhere. The softest beds in the world, and I am not allowed to use a single one."

[sub_resource type="Resource" id="PuffeLine_2"]
script = ExtResource("9_line")
trigger = 3
wave_number = 2
text = "Wizards throw fire at our towers. Walls do not bother them; towers do."

[sub_resource type="Resource" id="PuffeLine_3"]
script = ExtResource("9_line")
trigger = 3
wave_number = 3
text = "Priests heal the others. Hit the priest first!"
mood = 3

[sub_resource type="Resource" id="PuffeLine_4"]
script = ExtResource("9_line")
trigger = 3
wave_number = 4
text = "Giant eagles! They fly over the hedge, so build along their path too."

[sub_resource type="Resource" id="PuffeLine_u1125_shieldbearer"]
script = ExtResource("9_line")
trigger = 3
wave_number = 5
text = "Tower shields! Bolts glance off everyone near them. Beams, bursts and fire go round a shield."
mood = 2

