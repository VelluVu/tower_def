[sub_resource type="Resource" id="PuffeLine_1"]
script = ExtResource("9_line")
text = "The roost hums. Wasps, many wasps."

[sub_resource type="Resource" id="PuffeLine_harpooner"]
script = ExtResource("9_line")
text = "Meet the Harpooner! Its hooks drag the wasps out of the sky and into our maze. Even on the ground, nothing walks fast with a chain in its back."
mood = 1

